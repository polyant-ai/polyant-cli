{
  "name": "@polyant-ai/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Configure a Polyant instance as code",
  "type": "module",
  "bin": { "polyant-cli": "dist/bin.js" },
  "main": "dist/cli.js",
