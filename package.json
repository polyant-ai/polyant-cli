{
  "name": "@polyant-ai/cli",
  "version": "0.2.0",
  "description": "Configure a Polyant instance as code",
  "license": "LicenseRef-Polyant-Enterprise",
  "type": "module",
  "bin": {
    "polyant-cli": "dist/bin.js"
  },
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
